# ── AI Inference (pick ONE primary; both supported by lib/ai.ts) ─────────────
GEMINI_API_KEY=                 # Google Gemini API key (free tier) — used for structured-output prediction if AI_PROVIDER=gemini
GROQ_API_KEY=                   # Groq API key (free tier) — used for structured-output prediction if AI_PROVIDER=groq
AI_PROVIDER=gemini              # "gemini" or "groq" — selects which AI client lib/ai.ts uses at runtime

# ── Database / Cache (Supabase preferred; falls back to local JSON cache) ───
SUPABASE_URL=                   # Supabase project URL — stores scraped race data decoupled from prediction
SUPABASE_ANON_KEY=              # Supabase anon/public API key — used for client-safe reads
SUPABASE_SERVICE_ROLE_KEY=      # Supabase service role key — used server-side only, for writes from /api/scrape
USE_LOCAL_CACHE_FALLBACK=true   # "true"/"false" — if Supabase vars are unset, scraper/predict use local JSON cache instead

# ── Scraping target ──────────────────────────────────────────────────────────
RACING_SOURCE_BASE_URL=         # Base URL of the racing data source to scrape (hidden JSON API or HTML pages)
SCRAPER_USER_AGENT=             # Custom User-Agent header string to reduce anti-bot blocking on requests

# ── Security / internal ──────────────────────────────────────────────────────
CRON_SECRET=                    # Shared secret to authenticate scheduled/cron calls to /api/scrape (prevents public abuse)
NEXT_PUBLIC_APP_URL=            # Public base URL of the deployed app (used for internal fetch calls between API routes)

# ── Vercel runtime (set automatically by Vercel; no action needed locally) ──
VERCEL_ENV=                     # Populated by Vercel (development/preview/production) — read-only, informational